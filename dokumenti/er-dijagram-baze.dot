digraph MediCare {
  graph [rankdir=LR, splines=spline, overlap=false, nodesep=0.5, ranksep=1.5, pad=0.5, fontname="Arial", bgcolor="white", labelloc=t, labeljust=l, concentrate=false, newrank=true];
  label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="26" COLOR="#0A3556"><B>MediCare: ER dijagram baze podataka</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#4B6074">Microsoft SQL Server, Entity Framework Core (code-first). 25 tabela, 33 veze. Dijagram je izveden iz migracijskog snapshota (DatabaseContextModelSnapshot).</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#333333"><B>PK</B> primarni ključ   |   <B>FK</B> strani ključ   |   <B>UQ</B> jedinstvena vrijednost   |   <B>UQ*</B> dio složenog jedinstvenog ključa (Reservations: tretman + datum + vrijeme; RefreshTokens: korisnik + token)   |   <FONT COLOR="#B42318"><B>?</B></FONT> kolona može biti NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#333333"><B>Boja zaglavlja:</B>  <FONT COLOR="#0A3556"><B>■ Korisnici i pristup</B></FONT>   <FONT COLOR="#0B63A8"><B>■ Apoteka: katalog</B></FONT>   <FONT COLOR="#0A7478"><B>■ Korpa, narudžbe i plaćanje</B></FONT>   <FONT COLOR="#176A42"><B>■ Bolnica: tretmani i rezervacije</B></FONT>   <FONT COLOR="#5A4B81"><B>■ Zalihe i nabavka</B></FONT></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#333333">Veze: dvije crtice = strana "1" (roditelj); vilica s krugom = strana "N" (dijete, nula ili više zapisa); kod veze 1:1 (Inventories) dijete ima najviše jedan zapis. Sve veze koriste ograničenje brisanja Restrict.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#333333">Svaka tabela dodatno ima CreatedAtUtc, ModifiedAtUtc i IsDeleted (BaseEntity, soft delete); radi preglednosti nisu prikazane.</FONT></TD></TR></TABLE>>;
  node [shape=plaintext, fontname="Arial", fontsize=12];
  edge [fontname="Arial", fontsize=11, color="#5B7083", penwidth=1.4, dir=both, arrowsize=1.3];

  Roles [label=<<TABLE BORDER="1" COLOR="#0A3556" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0A3556" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id"><B>Id</B></TD><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id_t"><FONT POINT-SIZE="10" COLOR="#4B6074">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="Name_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Name">Name</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Name_t"><FONT POINT-SIZE="10" COLOR="#4B6074">nvarchar(max)</FONT></TD></TR></TABLE>>];
  Users [label=<<TABLE BORDER="1" COLOR="#0A3556" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0A3556" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id"><B>Id</B></TD><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id_t"><FONT POINT-SIZE="10" COLOR="#4B6074">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="FirstName_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="FirstName">FirstName</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="FirstName_t"><FONT POINT-SIZE="10" COLOR="#4B6074">nvarchar(max)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="LastName_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="LastName">LastName</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="LastName_t"><FONT POINT-SIZE="10" COLOR="#4B6074">nvarchar(max)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="DateOfBirth_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="DateOfBirth">DateOfBirth</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="DateOfBirth_t"><FONT POINT-SIZE="10" COLOR="#4B6074">datetime2</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="Adress_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Adress">Adress</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Adress_t"><FONT POINT-SIZE="10" COLOR="#4B6074">nvarchar(max)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="City_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="City">City</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="City_t"><FONT POINT-SIZE="10" COLOR="#4B6074">nvarchar(max)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="RoleId_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="RoleId">RoleId</TD><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="RoleId_t"><FONT POINT-SIZE="10" COLOR="#4B6074">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="UserName_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="UserName">UserName</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="UserName_t"><FONT POINT-SIZE="10" COLOR="#4B6074">nvarchar(max)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="Email_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Email">Email</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Email_t"><FONT POINT-SIZE="10" COLOR="#4B6074">nvarchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="PhoneNumber_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="PhoneNumber">PhoneNumber</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="PhoneNumber_t"><FONT POINT-SIZE="10" COLOR="#4B6074">nvarchar(max)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="IsEnabled_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="IsEnabled">IsEnabled</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="IsEnabled_t"><FONT POINT-SIZE="10" COLOR="#4B6074">bit</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="PasswordHash_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="PasswordHash">PasswordHash</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="PasswordHash_t"><FONT POINT-SIZE="10" COLOR="#4B6074">nvarchar(max)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="TokenVersion_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="TokenVersion">TokenVersion</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="TokenVersion_t"><FONT POINT-SIZE="10" COLOR="#4B6074">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="FcmToken_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="FcmToken">FcmToken</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="FcmToken_t"><FONT POINT-SIZE="10" COLOR="#4B6074">nvarchar(max)<FONT COLOR="#B42318"> ?</FONT></FONT></TD></TR></TABLE>>];
  RefreshTokens [label=<<TABLE BORDER="1" COLOR="#0A3556" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0A3556" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>RefreshTokens</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id"><B>Id</B></TD><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id_t"><FONT POINT-SIZE="10" COLOR="#4B6074">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="TokenHash_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>UQ*</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="TokenHash">TokenHash</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="TokenHash_t"><FONT POINT-SIZE="10" COLOR="#4B6074">nvarchar(450)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="ExpiresAtUtc_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="ExpiresAtUtc">ExpiresAtUtc</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="ExpiresAtUtc_t"><FONT POINT-SIZE="10" COLOR="#4B6074">datetime2</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="IsRevoked_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="IsRevoked">IsRevoked</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="IsRevoked_t"><FONT POINT-SIZE="10" COLOR="#4B6074">bit</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="UserId_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>FK UQ*</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="UserId">UserId</TD><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="UserId_t"><FONT POINT-SIZE="10" COLOR="#4B6074">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="Fingerprint_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Fingerprint">Fingerprint</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Fingerprint_t"><FONT POINT-SIZE="10" COLOR="#4B6074">nvarchar(200)<FONT COLOR="#B42318"> ?</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="RevokedAtUtc_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="RevokedAtUtc">RevokedAtUtc</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="RevokedAtUtc_t"><FONT POINT-SIZE="10" COLOR="#4B6074">datetime2<FONT COLOR="#B42318"> ?</FONT></FONT></TD></TR></TABLE>>];
  MedicineCategories [label=<<TABLE BORDER="1" COLOR="#0B63A8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0B63A8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>MedicineCategories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id"><B>Id</B></TD><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id_t"><FONT POINT-SIZE="10" COLOR="#4B6074">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="Name_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Name">Name</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Name_t"><FONT POINT-SIZE="10" COLOR="#4B6074">nvarchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="IsEnabled_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="IsEnabled">IsEnabled</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="IsEnabled_t"><FONT POINT-SIZE="10" COLOR="#4B6074">bit</FONT></TD></TR></TABLE>>];
  Medicine [label=<<TABLE BORDER="1" COLOR="#0B63A8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0B63A8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Medicine</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id"><B>Id</B></TD><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id_t"><FONT POINT-SIZE="10" COLOR="#4B6074">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="Name_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Name">Name</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Name_t"><FONT POINT-SIZE="10" COLOR="#4B6074">nvarchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="Price_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Price">Price</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Price_t"><FONT POINT-SIZE="10" COLOR="#4B6074">decimal(18,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="Description_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Description">Description</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Description_t"><FONT POINT-SIZE="10" COLOR="#4B6074">nvarchar(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="MedicineCategoryId_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="MedicineCategoryId">MedicineCategoryId</TD><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="MedicineCategoryId_t"><FONT POINT-SIZE="10" COLOR="#4B6074">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="ImagePath_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="ImagePath">ImagePath</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="ImagePath_t"><FONT POINT-SIZE="10" COLOR="#4B6074">nvarchar(max)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="Weight_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Weight">Weight</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Weight_t"><FONT POINT-SIZE="10" COLOR="#4B6074">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="isEnabled_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="isEnabled">isEnabled</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="isEnabled_t"><FONT POINT-SIZE="10" COLOR="#4B6074">bit</FONT></TD></TR></TABLE>>];
  MedicineReviews [label=<<TABLE BORDER="1" COLOR="#0B63A8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0B63A8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>MedicineReviews</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id"><B>Id</B></TD><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id_t"><FONT POINT-SIZE="10" COLOR="#4B6074">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="UserId_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="UserId">UserId</TD><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="UserId_t"><FONT POINT-SIZE="10" COLOR="#4B6074">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="MedicineId_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="MedicineId">MedicineId</TD><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="MedicineId_t"><FONT POINT-SIZE="10" COLOR="#4B6074">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="Rating_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Rating">Rating</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Rating_t"><FONT POINT-SIZE="10" COLOR="#4B6074">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="Comment_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Comment">Comment</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="Comment_t"><FONT POINT-SIZE="10" COLOR="#4B6074">nvarchar(max)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="ReviewDate_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="ReviewDate">ReviewDate</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="ReviewDate_t"><FONT POINT-SIZE="10" COLOR="#4B6074">datetime2</FONT></TD></TR></TABLE>>];
  Favourites [label=<<TABLE BORDER="1" COLOR="#0B63A8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0B63A8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Favourites</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id"><B>Id</B></TD><TD ALIGN="LEFT" BGCOLOR="#FFF8E1" PORT="Id_t"><FONT POINT-SIZE="10" COLOR="#4B6074">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="UserId_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="UserId">UserId</TD><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="UserId_t"><FONT POINT-SIZE="10" COLOR="#4B6074">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="MedicineId_k"><FONT POINT-SIZE="10" COLOR="#8A5300"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="MedicineId">MedicineId</TD><TD ALIGN="LEFT" BGCOLOR="#EEF5FB" PORT="MedicineId_t"><FONT POINT-SIZE="10" COLOR="#4B6074">int</FONT></TD></TR></TABLE>>];
